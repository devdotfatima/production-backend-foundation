# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
# Comma-separated browser origins. Empty falls back to APP_ORIGIN.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Configure either the exact proxy hop count or trusted proxy CIDRs/range names, never both.
# Direct-to-Node deployments use 0. Common examples: one load balancer = 1;
# Cloudflare = the published Cloudflare CIDRs, kept current by deployment automation.
TRUST_PROXY_HOPS=0
TRUST_PROXY_CIDRS=

# PostgreSQL. Keep connection_limit bounded; put PgBouncer in front in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public&connection_limit=10&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Redis / BullMQ / distributed rate limiting
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=backend-foundation
# Run all channels in one small-MVP process, or deploy channel-specific workers later.
WORKER_CHANNELS=EMAIL,SMS,PUSH,INTERNAL
EMAIL_WORKER_CONCURRENCY=5
EMAIL_HOURLY_SEND_LIMIT=10000
SMS_WORKER_CONCURRENCY=5
SMS_HOURLY_SEND_LIMIT=10000
PUSH_WORKER_CONCURRENCY=10
INTERNAL_WORKER_CONCURRENCY=5
# Per-process emergency limiter capacity used only while Redis is unavailable.
RATE_LIMIT_FALLBACK_MAX_KEYS=10000

# Auth (replace all example values; each secret must be at least 32 characters)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
TOKEN_HASH_SECRET=replace-with-a-different-32-char-secret
# Versioned master-key ring. HKDF derives independent token, metadata, and encryption keys.
# During rotation keep old entries for reads and change only CRYPTO_ACTIVE_KEY_ID for new writes.
CRYPTO_ACTIVE_KEY_ID=legacy
CRYPTO_KEYRING=
COOKIE_SECRET=replace-with-another-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BOOTSTRAP_ADMIN_EMAIL=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Providers. In development, missing provider configuration selects a structured-log adapter.
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_SERVICE_ACCOUNT_JSON=

# OIDC social login (set the client id(s) used by your web/mobile clients)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Stripe Checkout, billing, and webhook processing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_KEY=
STRIPE_PRICE_CATALOG=
# Disabled by default. Limits are minor units, e.g. {"usd":5000} means USD 50.00.
REFUND_SELF_SERVICE_ENABLED=false
REFUND_WINDOW_DAYS=30
REFUND_MAX_AMOUNT_BY_CURRENCY=

# File uploads. Clients upload directly using a signed S3 PUT or Cloudinary form.
UPLOAD_PROVIDER=disabled
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_URL_TTL_SECONDS=600
UPLOAD_USER_STORAGE_QUOTA_BYTES=1073741824
UPLOAD_USER_MONTHLY_BANDWIDTH_QUOTA_BYTES=5368709120
UPLOAD_SCAN_MODE=disabled
UPLOAD_SCAN_WEBHOOK_URL=

# S3 (ambient IAM credentials are preferred in production)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Scheduled retention cleanup. Set AUDIT_RETENTION_DAYS=0 to retain audit events indefinitely.
DATA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
RETENTION_BATCH_SIZE=500
# Separate HMAC key used to make audit-record mutation detectable; required in production.
AUDIT_INTEGRITY_SECRET=
