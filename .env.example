# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
# disabled | single | multi. See docs/feature-roadmap.md section 1 before changing this.
TENANCY_MODE=disabled
# Which entity owns the Stripe customer. `organization` requires a non-disabled TENANCY_MODE.
BILLING_OWNER=user
# Comma-separated browser origins. Empty falls back to APP_ORIGIN.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Configure either the exact proxy hop count or trusted proxy CIDRs/range names, never both.
# Direct-to-Node deployments use 0. Common examples: one load balancer = 1;
# Cloudflare = the published Cloudflare CIDRs, kept current by deployment automation.
TRUST_PROXY_HOPS=0
TRUST_PROXY_CIDRS=

# PostgreSQL. Keep connection_limit bounded; put PgBouncer in front in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public&connection_limit=10&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Redis / BullMQ / distributed rate limiting
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=backend-foundation
# Run all channels in one small-MVP process, or deploy channel-specific workers later.
WORKER_CHANNELS=EMAIL,SMS,PUSH,INTERNAL
EMAIL_WORKER_CONCURRENCY=5
EMAIL_HOURLY_SEND_LIMIT=10000
SMS_WORKER_CONCURRENCY=5
SMS_HOURLY_SEND_LIMIT=10000
PUSH_WORKER_CONCURRENCY=10
INTERNAL_WORKER_CONCURRENCY=5
# Per-process emergency limiter capacity used only while Redis is unavailable.
RATE_LIMIT_FALLBACK_MAX_KEYS=10000
# Scheduled jobs run in the worker process via BullMQ repeatable jobs. Leave disabled to keep
# using external cron against the maintenance:* entrypoints; both call the same handlers.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
SCHEDULER_STALE_AFTER_HOURS=36
# Chat (websockets). Disabled by default: a client who does not need it pays nothing.
CHAT_ENABLED=false
CHAT_SOCKET_PATH=/socket.io
# Keep the ping interval below the load balancer idle timeout, or connections are reaped
# mid-conversation. Confirm the balancer forwards the Upgrade header.
CHAT_PING_INTERVAL_MS=25000
CHAT_PING_TIMEOUT_MS=20000
CHAT_SESSION_REVALIDATE_MS=60000
CHAT_MAX_FRAME_BYTES=65536
CHAT_MAX_CONNECTIONS_PER_IP=60
CHAT_MAX_MESSAGES_PER_MINUTE=120
CHAT_MAX_EVENTS_PER_MINUTE=600
CHAT_MAX_ROOMS=100
CHAT_MAX_WRITE_BUFFER=512
CHAT_DRAIN_RECONNECT_MS=2000
# Coarse app-wide ceiling per client address (IPv6 buckets by /64). Stops single-source floods;
# a distributed botnet still needs a WAF in front.
RATE_LIMIT_IP_PER_MINUTE=600
# Comma-separated IPs/CIDRs exempt from IP limits: uptime monitors, internal callers.
RATE_LIMIT_ALLOWLIST_CIDRS=

# Auth (replace all example values; each secret must be at least 32 characters)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
TOKEN_HASH_SECRET=replace-with-a-different-32-char-secret
# Versioned master-key ring. HKDF derives independent token, metadata, and encryption keys.
# During rotation keep old entries for reads and change only CRYPTO_ACTIVE_KEY_ID for new writes.
CRYPTO_ACTIVE_KEY_ID=legacy
CRYPTO_KEYRING=
COOKIE_SECRET=replace-with-another-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BOOTSTRAP_ADMIN_EMAIL=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
# Distributed traces. The API and worker use distinct service.instance.id values while sharing
# this service name. Point the standard OTLP/HTTP endpoint at an OpenTelemetry Collector.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backend-foundation
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Standard comma-separated OTLP headers, for example: Authorization=Bearer token
OTEL_EXPORTER_OTLP_HEADERS=
# Prometheus text format on its own port -- never the public API port. Both the API and worker
# processes expose one; see README "Metrics" for the multi-process scrape configuration.
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_API_PORT=9464
METRICS_WORKER_PORT=9465
# Required (32+ random characters) when a production listener binds beyond loopback. Keep the
# listener behind a private service/firewall even when bearer authentication is enabled.
METRICS_BEARER_TOKEN=

# Providers. In development, missing provider configuration selects a structured-log adapter.
EMAIL_FROM=no-reply@example.com
EMAIL_PROVIDER=log
# One-click HTTPS unsubscribe URL for non-transactional email templates. Leave empty to fall back
# to a mailto: link to EMAIL_FROM; transactional templates never send these headers at all.
EMAIL_UNSUBSCRIBE_URL=
# HMAC secret for POST /api/v1/webhooks/email-events (32+ random characters in production).
EMAIL_EVENT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_SERVICE_ACCOUNT_JSON=
PUSH_PROVIDER=log

# OIDC social login (set the client id(s) used by your web/mobile clients)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Stripe Checkout, billing, and webhook processing
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_KEY=
STRIPE_PRICE_CATALOG=
# Dynamic (server-computed) charge amounts. The charge API takes a reference, never a price.
# Bounds are mandatory so a pricing bug is a rejected request rather than a huge charge.
DYNAMIC_PRICING_ENABLED=false
CHARGE_ALLOWED_CURRENCIES=
CHARGE_MIN_AMOUNT_BY_CURRENCY=
CHARGE_MAX_AMOUNT_BY_CURRENCY=
# Refunds are disabled by default. Limits are minor units, e.g. {"usd":5000} means USD 50.00.
REFUND_SELF_SERVICE_ENABLED=false
REFUND_WINDOW_DAYS=30
REFUND_MAX_AMOUNT_BY_CURRENCY=

# File uploads. Clients upload directly using a signed S3 PUT or Cloudinary form.
UPLOAD_PROVIDER=disabled
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_URL_TTL_SECONDS=600
# proxy streams authenticated downloads through Node. redirect authorizes and reserves quota,
# then sends the client to a short-lived S3 URL so application nodes do not carry file bandwidth.
UPLOAD_DOWNLOAD_MODE=proxy
UPLOAD_DOWNLOAD_URL_TTL_SECONDS=60
UPLOAD_USER_STORAGE_QUOTA_BYTES=1073741824
UPLOAD_USER_MONTHLY_BANDWIDTH_QUOTA_BYTES=5368709120
UPLOAD_SCAN_MODE=disabled
UPLOAD_SCAN_WEBHOOK_URL=
# Bearer credential sent to the scanner; required (32+ characters) in production webhook mode.
UPLOAD_SCAN_WEBHOOK_AUTH_TOKEN=
UPLOAD_SCAN_TIMEOUT_MS=30000
UPLOAD_PROVIDER_TIMEOUT_MS=30000

# S3 (ambient IAM credentials are preferred in production). The S3-compatible provider must
# support conditional PutObject with If-None-Match; enforce that header in bucket/IAM policy.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Scheduled retention cleanup. Set AUDIT_RETENTION_DAYS=0 to retain audit events indefinitely.
DATA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
RETENTION_BATCH_SIZE=500
# Separate HMAC key used to make audit-record mutation detectable; required in production.
AUDIT_INTEGRITY_SECRET=
