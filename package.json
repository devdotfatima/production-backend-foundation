{
  "name": "production-backend-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Express, Node.js, TypeScript, Prisma, PostgreSQL and BullMQ backend foundation",
  "type": "module",
  "imports": {
    "#app/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "build:assets": "node scripts/copy-template-assets.mjs",
    "dev": "tsx --conditions=development watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "tsx --conditions=development src/worker.ts",
    "worker:start": "node dist/src/worker.js",
    "maintenance:cleanup": "node dist/src/maintenance/cleanup.js",
    "maintenance:audit-verify": "node dist/src/maintenance/audit-verify.js",
    "maintenance:audit-backfill": "node dist/src/maintenance/audit-backfill.js",
    "tenancy:backfill": "tsx --conditions=development scripts/tenancy-backfill.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run build && node --env-file=.env.example ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:integration": "npm run build && node --env-file=.env.example ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "load:http": "tsx scripts/load/http-load.ts",
    "load:chat": "tsx scripts/load/chat-load.ts",
    "load:soak": "LOAD_DURATION_SECONDS=900 tsx scripts/load/http-load.ts",
    "test:watch": "npm run build && node --env-file=.env.example ./node_modules/vitest/vitest.mjs --config vitest.config.ts",
    "gen:module": "tsx --conditions=development scripts/gen-module.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "node scripts/prisma-migrate-status.mjs",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^6.19.3",
    "@prisma/instrumentation": "^6.19.0",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.6",
    "nodemailer": "^9.0.3",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "swagger-ui-dist": "^5.32.11",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.3",
    "testcontainers": "11.14.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
