generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  VERIFY_EMAIL
  VERIFY_PHONE
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  INTERNAL
}

enum NotificationDeliveryStatus {
  PROCESSING
  SENT
  DELIVERED
  SUPPRESSED
  BOUNCED
  COMPLAINED
  FAILED
}

enum EmailSuppressionReason {
  BOUNCE
  COMPLAINT
  MANUAL
}

enum OutboxStatus {
  PENDING
  CLAIMED
  ENQUEUED
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum StripeEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum SocialProvider {
  GOOGLE
  APPLE
}

enum UploadProvider {
  S3
  CLOUDINARY
}

enum UploadStatus {
  PENDING
  QUARANTINED
  SCANNING
  READY
  REJECTED
  FAILED
  DELETED
}

enum UploadVisibility {
  PRIVATE
  PUBLIC
}

enum ConversationType {
  DIRECT
  GROUP
  SUPPORT
}

enum ParticipantRole {
  OWNER
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
  ATTACHMENT
}

enum ChargeableStatus {
  OPEN
  RESERVED
  CONSUMED
  EXPIRED
  CANCELED
}

model User {
  id               String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String?
  displayName      String?
  locale           String     @default("en")
  pendingEmail     String?    @unique
  stripeCustomerId String?    @unique
  permissionEpoch  Int        @default(0)
  status           UserStatus @default(PENDING)
  emailVerifiedAt  DateTime?  @db.Timestamptz(3)
  phoneVerifiedAt  DateTime?  @db.Timestamptz(3)
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?  @db.Timestamptz(3)

  sessions             Session[]
  refreshTokens        RefreshToken[]
  otpChallenges        OtpChallenge[]
  passwordResetTokens  PasswordResetToken[]
  devices              Device[]
  socialAccounts       SocialAccount[]
  memberships          Membership[]              @relation("OrganizationMemberships")
  membershipsInvited   Membership[]              @relation("MembershipInviter")
  invitationsSent      Invitation[]              @relation("InvitationInviter")
  stripeSubscriptions  StripeSubscription[]
  stripePayments       StripePayment[]
  stripeRefunds        StripeRefundOperation[]
  paymentMethods       PaymentMethod[]
  conversations        ConversationParticipant[]
  messages             Message[]
  uploads              Upload[]
  uploadBandwidthUsage UploadBandwidthUsage[]
  roles                UserRole[]
  auditEvents          AuditEvent[]              @relation("AuditActor")
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]

  @@index([status, deletedAt])
  @@map("users")
}

/// A tenant. Absent entirely when TENANCY_MODE=disabled; a single implicit row in `single` mode.
model Organization {
  id               String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug             String             @unique
  name             String
  status           OrganizationStatus @default(ACTIVE)
  /// Bumped when any org-scoped role changes, so one write invalidates every member's cached
  /// permission decisions instead of an unbounded per-member update.
  permissionEpoch  Int                @default(0)
  settings         Json?
  stripeCustomerId String?            @unique
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?          @db.Timestamptz(3)

  memberships              Membership[]
  invitations              Invitation[]
  roles                    Role[]
  sessions                 Session[]
  uploads                  Upload[]
  uploadBandwidthUsage     UploadBandwidthUsage[]
  stripeSubscriptions      StripeSubscription[]
  stripePayments           StripePayment[]
  stripeRefunds            StripeRefundOperation[]
  paymentMethods           PaymentMethod[]
  chargeableItems          ChargeableItem[]
  conversations            Conversation[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  auditEvents              AuditEvent[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]

  @@index([status, deletedAt])
  @@map("organizations")
}

model Membership {
  id              String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String           @db.Uuid
  userId          String           @db.Uuid
  roleId          String           @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  invitedByUserId String?          @db.Uuid
  joinedAt        DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId, status, deletedAt])
  @@index([organizationId, status, deletedAt])
  @@map("memberships")
}

model Invitation {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String    @db.Uuid
  email           String
  roleId          String    @db.Uuid
  tokenHash       String    @unique
  expiresAt       DateTime  @db.Timestamptz(3)
  acceptedAt      DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  invitedByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("invitations")
}

model Role {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  /// Null identifies a global/system role that satisfies a permission check in any scope.
  /// Global uniqueness of `name` for those rows is enforced by a partial index in the migration,
  /// because Postgres treats NULLs as distinct within a composite unique constraint.
  organizationId String?   @db.Uuid
  name           String
  description    String?
  isSystem       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        UserRole[]
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, name])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  roles RolePermission[]

  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId, deletedAt])
  @@map("user_roles")
}

model RolePermission {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  roleId       String    @db.Uuid
  permissionId String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId, deletedAt])
  @@map("role_permissions")
}

model Session {
  id                   String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId               String    @db.Uuid
  /// Authoritative tenant for the session. Deliberately server-side state rather than a
  /// client-supplied header, which would be attacker-controlled.
  activeOrganizationId String?   @db.Uuid
  familyId             String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ipHash               String?
  userAgent            String?
  expiresAt            DateTime  @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  revokeReason         String?
  lastSeenAt           DateTime  @default(now()) @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime? @db.Timestamptz(3)

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization?  @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt, id])
  @@index([revokedAt, id])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String    @db.Uuid
  sessionId         String    @db.Uuid
  tokenHash         String    @unique
  replacedByTokenId String?   @unique @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(3)
  consumedAt        DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id                    String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId                String?    @db.Uuid
  normalizedDestination String
  channel               OtpChannel
  purpose               OtpPurpose
  codeHash              String
  attempts              Int        @default(0)
  maxAttempts           Int        @default(5)
  sentAt                DateTime   @default(now()) @db.Timestamptz(3)
  expiresAt             DateTime   @db.Timestamptz(3)
  verifiedAt            DateTime?  @db.Timestamptz(3)
  consumedAt            DateTime?  @db.Timestamptz(3)
  lockedAt              DateTime?  @db.Timestamptz(3)
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?  @db.Timestamptz(3)

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordResetToken PasswordResetToken?

  @@index([normalizedDestination, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model PasswordResetToken {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String    @db.Uuid
  otpChallengeId String    @unique @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpChallenge OtpChallenge @relation(fields: [otpChallengeId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Device {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String    @db.Uuid
  fcmToken   String    @unique
  platform   String?
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("devices")
}

model SocialAccount {
  id                String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String         @db.Uuid
  provider          SocialProvider
  providerAccountId String
  email             String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?      @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, deletedAt])
  @@map("social_accounts")
}

model OutboxEvent {
  id                 String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  aggregateType      String
  aggregateId        String
  eventType          String
  channel            NotificationChannel
  payload            Json
  /// W3C trace-context carrier captured with the business transaction. It reconnects API,
  /// relay, queue, retry, and worker spans without putting tracing metadata in domain payloads.
  traceContext       Json?
  dedupeKey          String              @unique
  status             OutboxStatus        @default(PENDING)
  attempts           Int                 @default(0)
  deliveryGeneration Int                 @default(0)
  availableAt        DateTime            @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime?           @db.Timestamptz(3)
  claimedAt          DateTime?           @db.Timestamptz(3)
  claimExpiresAt     DateTime?           @db.Timestamptz(3)
  claimToken         String?             @db.Uuid
  enqueuedAt         DateTime?           @db.Timestamptz(3)
  deliveredAt        DateTime?           @db.Timestamptz(3)
  failedAt           DateTime?           @db.Timestamptz(3)
  deadLetteredAt     DateTime?           @db.Timestamptz(3)
  lastError          String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?           @db.Timestamptz(3)

  delivery NotificationDelivery?

  @@index([status, availableAt, createdAt])
  @@index([status, expiresAt])
  @@index([status, claimExpiresAt])
  @@index([status, deadLetteredAt, id])
  @@index([status, updatedAt, id])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model NotificationPreference {
  id             String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?             @db.Uuid
  userId         String              @db.Uuid
  /// "global" or the organization UUID; avoids nullable-unique semantics.
  scopeKey       String
  channel        NotificationChannel
  topic          String
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeKey, channel, topic])
  @@index([organizationId, userId, channel, deletedAt])
  @@map("notification_preferences")
}

model EmailSuppression {
  id              String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  destinationHash String                 @unique
  reason          EmailSuppressionReason
  provider        String?
  providerEventId String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?              @db.Timestamptz(3)

  @@index([reason, createdAt])
  @@map("email_suppressions")
}

model NotificationDelivery {
  id                String                     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId    String?                    @db.Uuid
  userId            String?                    @db.Uuid
  outboxEventId     String                     @unique @db.Uuid
  channel           NotificationChannel
  destinationHash   String?
  templateKey       String?
  provider          String?
  providerMessageId String?                    @unique
  status            NotificationDeliveryStatus @default(PROCESSING)
  attempts          Int                        @default(0)
  lastError         String?
  sentAt            DateTime?                  @db.Timestamptz(3)
  deliveredAt       DateTime?                  @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?                  @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  outboxEvent  OutboxEvent   @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([destinationHash, createdAt])
  @@map("notification_deliveries")
}

model AuditEvent {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String?   @db.Uuid
  actorUserId      String?   @db.Uuid
  action           String
  entityType       String
  entityId         String?
  requestId        String?
  ipHash           String?
  userAgent        String?
  metadata         Json?
  integrityHash    String
  integrityVersion Int       @default(1)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt, id])
  @@map("audit_events")
}

model StripeWebhookEvent {
  id              String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  stripeEventId   String            @unique
  stripeCreatedAt DateTime          @db.Timestamptz(3)
  type            String
  apiVersion      String?
  livemode        Boolean
  payload         Json
  status          StripeEventStatus @default(RECEIVED)
  processedAt     DateTime?         @db.Timestamptz(3)
  lastError       String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?         @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("stripe_webhook_events")
}

model StripeSubscription {
  id                       String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId           String?   @db.Uuid
  userId                   String    @db.Uuid
  stripeSubscriptionId     String    @unique
  status                   String
  priceId                  String?
  currency                 String?
  currentPeriodStart       DateTime? @db.Timestamptz(3)
  currentPeriodEnd         DateTime? @db.Timestamptz(3)
  cancelAtPeriodEnd        Boolean   @default(false)
  canceledAt               DateTime? @db.Timestamptz(3)
  lastStripeEventId        String?
  lastStripeEventCreatedAt DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime? @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, deletedAt])
  @@index([userId, status, deletedAt])
  @@map("stripe_subscriptions")
}

model StripePayment {
  id                       String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId           String?   @db.Uuid
  userId                   String    @db.Uuid
  stripePaymentIntentId    String?   @unique
  checkoutSessionId        String?   @unique
  chargeId                 String?   @unique
  status                   String
  amount                   Int?
  amountRefunded           Int       @default(0)
  currency                 String?
  lastStripeEventId        String?
  lastStripeEventCreatedAt DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime? @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([userId, status, createdAt])
  @@map("stripe_payments")
}

model Conversation {
  id              String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String?          @db.Uuid
  type            ConversationType
  title           String?
  createdByUserId String?          @db.Uuid
  /// Per-conversation gap-free counter. UUIDv7 is time-ordered but cannot distinguish a gap from
  /// a pause, which is what reconnect-and-catch-up needs.
  lastSeq         BigInt           @default(0)
  lastMessageAt   DateTime?        @db.Timestamptz(3)
  metadata        Json?
  /// Deterministic tenant + sorted-user key for DIRECT conversations. Null for group/support
  /// conversations. The unique constraint closes the find-then-create race across API replicas.
  directKey       String?          @unique
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)

  organization Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?         @db.Uuid
  conversationId String          @db.Uuid
  userId         String          @db.Uuid
  role           ParticipantRole @default(MEMBER)
  /// Unread count is `conversation.lastSeq - lastReadSeq`; no per-message read rows required.
  lastReadSeq    BigInt          @default(0)
  mutedUntil     DateTime?       @db.Timestamptz(3)
  joinedAt       DateTime        @default(now()) @db.Timestamptz(3)
  leftAt         DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?       @db.Timestamptz(3)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId, leftAt, deletedAt])
  @@map("conversation_participants")
}

model Message {
  id              String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String?     @db.Uuid
  conversationId  String      @db.Uuid
  senderUserId    String?     @db.Uuid
  seq             BigInt
  /// Client-generated. Makes a retried send return the original message instead of duplicating
  /// it — without this, every flaky mobile connection produces double posts.
  clientMessageId String
  type            MessageType @default(TEXT)
  body            String?
  uploadId        String?     @db.Uuid
  editedAt        DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?   @db.Timestamptz(3)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([conversationId, seq])
  @@unique([conversationId, clientMessageId])
  @@index([conversationId, seq(sort: Desc)])
  @@map("messages")
}

/// A saved card. Only Stripe identifiers and display metadata are stored — never a PAN, CVC, or
/// anything else that would take this service out of PCI SAQ-A.
model PaymentMethod {
  id                    String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId        String?   @db.Uuid
  userId                String    @db.Uuid
  stripePaymentMethodId String    @unique
  type                  String
  brand                 String?
  last4                 String?
  expMonth              Int?
  expYear               Int?
  /// Stripe's cross-customer duplicate detector; useful for "you already saved this card".
  fingerprint           String?
  isDefault             Boolean   @default(false)
  /// Recorded at setup so later off-session charges have a mandate to reference.
  mandateId             String?
  detachedAt            DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime? @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, deletedAt])
  @@index([userId, deletedAt])
  @@map("payment_methods")
}

/// Server-owned amount for a dynamic charge.
///
/// The charge API accepts a `reference`, never a price: the amount is resolved here or by a
/// client project's own `ChargeableResolver`. A request body must never be able to influence
/// what is charged.
model ChargeableItem {
  id              String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String?          @db.Uuid
  userId          String?          @db.Uuid
  reference       String
  amount          Int
  currency        String
  description     String
  metadata        Json?
  status          ChargeableStatus @default(OPEN)
  /// Hash of the business idempotency key that owns the current reservation. The raw key is
  /// never persisted. Only the same logical request may resume an interrupted Stripe call.
  reservationKeyHash String?
  reservedAt      DateTime?        @db.Timestamptz(3)
  expiresAt       DateTime?        @db.Timestamptz(3)
  consumedAt      DateTime?        @db.Timestamptz(3)
  paymentIntentId String?          @unique
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([status, reservedAt])
  @@index([status, expiresAt])
  @@map("chargeable_items")
}

model StripeRefundOperation {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId     String?   @db.Uuid
  userId             String    @db.Uuid
  /// Stable billing-owner namespace. Organization members share idempotency at the owner level.
  ownerKey           String
  idempotencyKeyHash String
  requestHash        String
  paymentIntentId    String?
  chargeId           String?
  requestedAmount    Int?
  stripeRefundId     String?   @unique
  status             String    @default("PENDING")
  amount             Int?
  currency           String?
  lastError          String?
  completedAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([ownerKey, idempotencyKeyHash])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([paymentIntentId])
  @@index([chargeId])
  @@map("stripe_refund_operations")
}

model Upload {
  id                  String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId      String?          @db.Uuid
  userId              String           @db.Uuid
  provider            UploadProvider
  status              UploadStatus     @default(PENDING)
  visibility          UploadVisibility @default(PRIVATE)
  objectKey           String
  originalName        String
  contentType         String
  expectedSize        BigInt
  actualSize          BigInt?
  checksum            String?
  detectedContentType String?
  scanProvider        String?
  scanReference       String?
  scanVerdict         String?
  scannedAt           DateTime?        @db.Timestamptz(3)
  url                 String?
  uploadExpiresAt     DateTime         @db.Timestamptz(3)
  readyAt             DateTime?        @db.Timestamptz(3)
  /// Set only after the asynchronous provider deletion succeeds during erasure/cleanup.
  storageDeletedAt    DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?        @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([provider, objectKey])
  @@index([organizationId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, uploadExpiresAt])
  @@map("uploads")
}

model UploadBandwidthUsage {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String   @db.Uuid
  /// Explicit quota namespace; unlike a nullable composite key, this is conflict-safe globally.
  scopeKey       String
  periodStart    DateTime @db.Date
  bytes          BigInt   @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, periodStart])
  @@index([userId, periodStart])
  @@index([organizationId, periodStart])
  @@map("upload_bandwidth_usage")
}

model IdempotencyRecord {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorKey    String
  scope       String
  keyHash     String
  requestHash String
  statusCode  Int?
  response    Json?
  /// External-side-effect operations use a renewable ownership lease. Database-only operations
  /// complete the record and mutation in one transaction and leave these fields null.
  lockToken   String?   @db.Uuid
  lockedUntil DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  @@unique([actorKey, scope, keyHash])
  @@index([expiresAt])
  @@index([lockedUntil])
  @@map("idempotency_records")
}

